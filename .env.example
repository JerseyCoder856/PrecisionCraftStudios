# Server
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/precision-craft-studios.sqlite
REQUEST_SIZE_LIMIT=1mb

# PayPal Checkout
# Use sandbox while testing, then switch to live with live credentials for production.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=replace-with-paypal-rest-app-client-id
PAYPAL_CLIENT_SECRET=replace-with-paypal-rest-app-secret
PAYPAL_WEBHOOK_ID=replace-with-paypal-webhook-id
# Comma-separated PayPal SDK funding buttons to request and render when eligible.
PAYPAL_ENABLED_FUNDING=paypal,paylater,venmo,card
# Optional comma-separated funding sources to suppress. Leave blank by default.
PAYPAL_DISABLED_FUNDING=
# Optional two-letter buyer country passed to the PayPal JS SDK.
PAYPAL_BUYER_COUNTRY=US

# Optional operations metadata.
ADMIN_ORDER_EMAIL=precisioncraftstudios@gmail.com
FORMSPREE_ENDPOINT=
